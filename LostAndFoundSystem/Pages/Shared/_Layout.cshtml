@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    var itemTypeQuery = Context.Request.Query["ItemType"].ToString();

    string Active(bool isActive) => isActive ? "active" : "";
    bool isHome = path == "/" || path == "/index";
    bool isBrowse = path.StartsWith("/items") && !path.StartsWith("/items/report") && !path.StartsWith("/items/myreports") && !path.StartsWith("/items/edit");
    bool isReportLost = path.StartsWith("/items/report") && itemTypeQuery != "Found";
    bool isReportFound = path.StartsWith("/items/report") && itemTypeQuery == "Found";

    var fullName = User.Identity?.Name ?? "";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
    var initial = fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Lost & Found</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LostAndFoundSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">
                    <span class="brand-mark"><i class="bi bi-search-heart"></i></span>
                    <span>Lost<span class="brand-amp">&amp;</span>Found</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-1 mt-3 mt-lg-0">
                        <li class="nav-item"><a class="nav-link @Active(isHome)" asp-page="/Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active(isBrowse)" asp-page="/Items/Index">Browse Items</a></li>
                        <li class="nav-item"><a class="nav-link @Active(isReportLost)" asp-page="/Items/Report" asp-route-ItemType="Lost">Report Lost</a></li>
                        <li class="nav-item"><a class="nav-link @Active(isReportFound)" asp-page="/Items/Report" asp-route-ItemType="Found">Report Found</a></li>
                    </ul>

                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active(path.StartsWith("/items/myreports"))" asp-page="/Items/MyReports">
                                    <i class="bi bi-card-list me-1"></i>My Reports
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active(path.StartsWith("/messages"))" asp-page="/Messages/Index">
                                    <i class="bi bi-chat-dots me-1"></i>Messages
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar">@initial</span>
                                    <span>@firstName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="px-3 py-2 small text-muted">Signed in as<br /><strong class="text-dark">@fullName</strong></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-page="/Items/MyReports"><i class="bi bi-card-list me-2"></i>My Reports</a></li>
                                    <li><a class="dropdown-item" asp-page="/Messages/Index"><i class="bi bi-chat-dots me-2"></i>My Messages</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-page="/Account/Logout">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i>Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Log in</a></li>
                            <li class="nav-item ms-lg-1">
                                <a class="btn btn-primary" asp-page="/Account/Register">Get started</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 py-lg-5">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <a class="navbar-brand mb-3" asp-page="/Index">
                        <span class="brand-mark"><i class="bi bi-search-heart"></i></span>
                        <span>Lost<span class="brand-amp">&amp;</span>Found</span>
                    </a>
                    <p class="mt-3 mb-0" style="max-width: 340px;">
                        Helping our community reunite people with the things they've lost, one report at a time.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <h6>Explore</h6>
                    <a asp-page="/Items/Index">Browse items</a><br />
                    <a asp-page="/Items/Report" asp-route-ItemType="Lost">Report a lost item</a><br />
                    <a asp-page="/Items/Report" asp-route-ItemType="Found">Report a found item</a>
                </div>
                <div class="col-6 col-md-4">
                    <h6>Your account</h6>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-page="/Items/MyReports">My reports</a><br />
                        <a asp-page="/Messages/Index">My messages</a>
                    }
                    else
                    {
                        <a asp-page="/Account/Login">Log in</a><br />
                        <a asp-page="/Account/Register">Create an account</a>
                    }
                </div>
            </div>
            <div class="footer-bottom d-flex flex-wrap justify-content-between gap-2">
                <span>© @DateTime.Now.Year Lost & Found Management System</span>
                <span>Made with <i class="bi bi-heart-fill text-danger"></i> by our group</span>
            </div>
        </div>
    </footer>

    <!-- Custom confirmation popup (used by data-confirm buttons) -->
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content confirm-modal">
                <div class="modal-body text-center p-4 p-md-5">
                    <div class="confirm-icon mb-3" id="confirmIcon"><i class="bi bi-question-lg"></i></div>
                    <h5 class="mb-2" id="confirmTitle">Are you sure?</h5>
                    <p class="text-muted mb-4" id="confirmMessage"></p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary px-4" id="confirmOk">Confirm</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>