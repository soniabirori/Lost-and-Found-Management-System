@page
@model LostAndFoundSystem.Pages.Items.MyReportsModel
@{
    ViewData["Title"] = "My reports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My reports</h2>
    <a class="btn btn-primary" asp-page="/Items/Report">Report an item</a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.ErrorMessage.Length > 0)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Reports.Count == 0 && Model.ErrorMessage.Length == 0)
{
    <p class="text-muted">You have not reported any items yet.</p>
}
else if (Model.Reports.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Type</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reports)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(r.PhotoPath))
                            {
                                <img src="@r.PhotoPath" alt="@r.Title" class="rounded"
                                     style="width:60px; height:60px; object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted small">No photo</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(r.ItemType == "Lost" ? "bg-danger" : "bg-success")">@r.ItemType</span>
                        </td>
                        <td>@r.Title</td>
                        <td>@r.Category</td>
                        <td>@r.Location</td>
                        <td>@r.EventDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @(r.Status == "Returned" ? "bg-secondary" : "bg-primary")">@r.Status</span>
                        </td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Items/Details" asp-route-id="@r.Id">View</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Items/Edit" asp-route-id="@r.Id">Edit</a>

                            @if (r.Status == "Open")
                            {
                                <form method="post" asp-page-handler="MarkReturned" asp-route-id="@r.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success"
                                            onclick="return confirm('Mark this item as returned?');">Mark returned</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Reopen" asp-route-id="@r.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Reopen</button>
                                </form>
                            }

                            <form method="post" asp-page-handler="Delete" asp-route-id="@r.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete this report permanently? Messages about it will also be deleted.');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}