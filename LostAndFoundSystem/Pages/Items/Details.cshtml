@page "{id:int}"
@model LostAndFoundSystem.Pages.Items.DetailsModel
@{
    ViewData["Title"] = Model.Item?.Title ?? "Item details";
}

<a asp-page="/Items/Index" class="btn btn-link px-0 mb-3">← Back to all items</a>

@if (Model.ErrorMessage.Length > 0)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.Item != null)
{
    var item = Model.Item;

    <div class="row g-4">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(item.PhotoPath))
            {
                <img src="@item.PhotoPath" alt="@item.Title" class="img-fluid rounded shadow-sm w-100"
                     style="max-height:420px; object-fit:cover;" />
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted"
                     style="height:320px;">No photo provided</div>
            }
        </div>

        <div class="col-md-6">
            <span class="badge fs-6 @(item.ItemType == "Lost" ? "bg-danger" : "bg-success")">@item.ItemType</span>
            <span class="badge fs-6 @(item.Status == "Returned" ? "bg-secondary" : "bg-primary")">@item.Status</span>

            <h2 class="mt-3">@item.Title</h2>

            <table class="table mt-3">
                <tr><th style="width:40%">Category</th><td>@item.Category</td></tr>
                <tr><th>Location</th><td>@item.Location</td></tr>
                <tr><th>Date @(item.ItemType == "Lost" ? "lost" : "found")</th><td>@item.EventDate.ToString("dd MMM yyyy")</td></tr>
                <tr><th>Reported by</th><td>@item.ReporterName</td></tr>
                <tr><th>Reported on</th><td>@item.CreatedAt.ToString("dd MMM yyyy, HH:mm")</td></tr>
            </table>

            <h5>Description</h5>
            <p>@(string.IsNullOrWhiteSpace(item.Description) ? "No description given." : item.Description)</p>

            <!-- Contact section -->
            @if (Model.IsOwner)
            {
                <div class="alert alert-info">
                    This is your report. Manage it in <a asp-page="/Items/MyReports">My Reports</a>.
                </div>
            }
            else if (item.Status == "Returned")
            {
                <div class="alert alert-secondary">This item has already been returned.</div>
            }
            else if (User.Identity?.IsAuthenticated == true)
            {
                <div class="card mt-3">
                    <div class="card-body">
                        <h5 class="card-title">
                            @(item.ItemType == "Lost" ? "Found this item? Contact the owner" : "Is this yours? Contact the finder")
                        </h5>
                        <form method="post" asp-page-handler="SendMessage" asp-route-id="@item.Id">
                            <textarea class="form-control mb-2" asp-for="MessageBody" rows="3" maxlength="1000"
                                      placeholder="Describe the item or say where you can meet..."></textarea>
                            <button type="submit" class="btn btn-primary">Send message</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light border">
                    <a asp-page="/Account/Login" asp-route-returnUrl="/Items/Details/@item.Id">Log in</a>
                    to contact the @(item.ItemType == "Lost" ? "owner" : "finder").
                </div>
            }
        </div>
    </div>
}