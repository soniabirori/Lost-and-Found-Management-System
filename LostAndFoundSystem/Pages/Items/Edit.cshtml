@page "{id:int}"
@model LostAndFoundSystem.Pages.Items.EditModel
@{
    ViewData["Title"] = "Edit item";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <a asp-page="/Items/MyReports" class="btn btn-link px-0 mb-2">← Back to My Reports</a>
        <h2 class="mb-4">Edit item</h2>

        @if (Model.ErrorMessage.Length > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.ErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label class="form-label d-block">This item was...</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="ItemType" value="Lost" id="typeLost" />
                    <label class="form-check-label" for="typeLost">Lost</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="ItemType" value="Found" id="typeFound" />
                    <label class="form-check-label" for="typeFound">Found</label>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" asp-for="Title" />
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>
                <select class="form-select" asp-for="Category">
                    <option value="">-- Choose a category --</option>
                    @foreach (var c in LostAndFoundSystem.Pages.Items.ReportModel.Categories)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Description (optional)</label>
                <textarea class="form-control" asp-for="Description" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-7 mb-3">
                    <label class="form-label">Location</label>
                    <input class="form-control" asp-for="Location" />
                </div>
                <div class="col-md-5 mb-3">
                    <label class="form-label">Date lost / found</label>
                    <input type="date" class="form-control" asp-for="EventDate" asp-format="{0:yyyy-MM-dd}" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Photo</label>
                @if (!string.IsNullOrEmpty(Model.CurrentPhotoPath))
                {
                    <div class="mb-2">
                        <img src="@Model.CurrentPhotoPath" alt="Current photo" class="rounded"
                             style="width:120px; height:120px; object-fit:cover;" />
                        <div class="form-text">Current photo. Upload a new one below to replace it.</div>
                    </div>
                }
                <input type="file" class="form-control" asp-for="Photo" accept="image/*" />
            </div>

            <button type="submit" class="btn btn-primary">Save changes</button>
            <a class="btn btn-outline-secondary" asp-page="/Items/MyReports">Cancel</a>
        </form>
    </div>
</div>